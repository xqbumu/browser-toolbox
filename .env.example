# Firefox 扩展 ID（需与 AMO 后台或 web-ext 签名一致）
# AMO 只接受两种合法格式："{GUID}"（花括号 UUID，如 {dce76df2-a5e6-11f1-8000-ea8e987d26d5}）
# 或 email 形 "name@domain"。裸 UUID（无花括号）会被 addons.mozilla.org 拒绝（JSON_INVALID）。
# 构建脚本会自动为裸 UUID 补花括号，但建议此处直接写花括号格式。
FIREFOX_EXTENSION_ID={your-extension-uuid-in-braces-or-id@domain.com}

# Mozilla AMO API 凭证（用于 web-ext sign 本地签名）
# 在 https://addons.mozilla.org/zh-CN/developers/addon/api/key 申请
FIREFOX_JWT_ISSUER=your-jwt-issuer
FIREFOX_JWT_PRIVATE_KEY=your-jwt-private-key